NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=chat
# Local development only. Production requires schema migrations.
DB_SYNCHRONIZE=true

REDIS_URL=redis://localhost:6379
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=chat
KEYCLOAK_CLIENT_ID=chat-backend
# Expected API audience in the access token's aud claim; defaults to KEYCLOAK_CLIENT_ID.
KEYCLOAK_AUDIENCE=chat-api

# Optional NestJS Observe integration
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
